    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/iconamoon": "^1.2.2",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify/json": "^2.2.549",
    "@kirklin/eslint-config": "^8.5.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tarojs/cli": "4.3.1",
    "@tarojs/plugin-html": "4.3.1",
    "@tarojs/taro-loader": "4.3.1",
    "@tarojs/test-utils-react": "^0.1.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
