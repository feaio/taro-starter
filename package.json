    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "react-refresh": "^0.19.0",
    "stylelint": "^17.16.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~6.0.3",
    "unocss": "~66.7.5",
    "unocss-applet": "0.13.8",
    "unocss-preset-chinese": "^0.3.3",
    "unocss-preset-ease": "^0.0.4",
    "webpack": "5.91.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.31",
      "@unocss/core": "~66.7.5",
      "magic-string": "^0.30.21",
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  },
  "lint-staged": {
    "**/*": "eslint --fix"
  }
}
