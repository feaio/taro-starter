    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.107.0",
    "sr-sdk-wxapp": "^2.1.1",
    "taro-hooks": "^2.2.0",
    "yet-another-abortcontroller-polyfill": "^0.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
