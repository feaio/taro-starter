{
  "compilerOptions": {
    "target": "es2017",
    "jsx": "react-jsx",
    "lib": ["ESNext", "dom"],
    "experimentalDecorators": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "allowJs": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "preserveConstEnums": true,
    "removeComments": false,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["./src", "./types", "./config", "./unocss.config.ts"],
  "exclude": ["dist", "node_modules"],
  "compileOnSave": false
}
